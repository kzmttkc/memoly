# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# cronジョブの実行ログ(billing_e2e_cron.sh等)
/logs/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase
supabase/.temp/
e2e-captures/

# ローカル論理バックアップ（顧客データ・絶対にコミットしない）
backups/

# === Kizuna Creation 標準セキュリティ除外（全リポジトリ共通） ===
# .env* は既にignore済みだが env.txt はどのパターンにも一致しない穴だったため追加
env.txt
secrets.json
credentials.json
config/x_keys.json
# 署名鍵・証明書・パスワードファイル
*.keystore
*.jks
*.key
keystore.properties
# ビルド成果物
*.aab
*.apk
